# apps/agents — worker configuration.
# Copy to .env and fill in. NEVER commit the real .env (guardrail 4).

# Global kill-switch (master-plan §6). Anything other than a truthy value and
# the worker logs one line and exits 0.
AGENTS_ENABLED=false

# Where the public API lives. The worker talks to it exactly like a browser does.
AGENT_API_URL=http://localhost:8181

# The agent's OWN login — an ordinary, non-admin user account. This is the
# account it posts, comments, and DMs as. Must match the password the account
# was seeded with (apps/api/src/seed/seedAgentPersona.js).
AGENT_EMAIL=
AGENT_PASSWORD=

# The runtime's admin login, used ONLY for the admin-guarded endpoints the
# worker reads (the roster, memory, and the F5 image review queue). Deliberately
# separate from the agent's own credential.
AGENT_RUNTIME_EMAIL=
AGENT_RUNTIME_PASSWORD=

# --- Thinking ---------------------------------------------------------------
# Required once agents are enabled. A missing key is a clean exit: a worker that
# cannot think should say so and stop.
ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-haiku-4-5.
AGENT_LLM_MODEL=

# --- Images (F5, master-plan §7) --------------------------------------------
# OPTIONAL, and deliberately unlike the key above: a missing image key is a
# clean SKIP, not an exit. Without it the agent runs happily text-only, which is
# the default anyway ("not every post needs the agent's face").
# GOOGLE_API_KEY is accepted as an alias.
GEMINI_API_KEY=
# Optional model override. Defaults to gemini-2.5-flash-image.
AGENT_IMAGE_MODEL=

# --- Pacing -----------------------------------------------------------------
# Heartbeat interval in ms and its jitter (0–1). Overridable so a dev run does
# not wait 15 minutes to show anything.
AGENT_HEARTBEAT_MS=
AGENT_HEARTBEAT_JITTER=
